# Server runtime
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=8787

# Optional app base path, for deployments behind a subpath.
# Example: NEXT_PUBLIC_BASE_PATH=/dark-importer
NEXT_PUBLIC_BASE_PATH=/

# Basic request safety limits
REQUEST_BODY_LIMIT_BYTES=1048576
PROXY_RESPONSE_LIMIT_BYTES=26214400
PROXY_TIMEOUT_MS=30000
